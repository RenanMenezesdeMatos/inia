# =====================================================================================================================
# INIA — frontend (Next.js). Copie para frontend/.env.local — ou rode, na raiz, `npm run env:init`.
# Variáveis NEXT_PUBLIC_* entram no pacote do navegador NO MOMENTO DO BUILD: mudou, rode `npm run build` de novo.
# =====================================================================================================================

# Endereço da API como o NAVEGADOR enxerga (chamadas feitas pelo browser).
NEXT_PUBLIC_INIA_API_URL=http://localhost:3333
# Endereço da API como o SERVIDOR do Next enxerga (renderização no servidor). Normalmente o mesmo.
INIA_API_URL=http://localhost:3333

# Modelo 3D do avatar (arquivo em frontend/public/models).
NEXT_PUBLIC_INIA_AVATAR_MODEL_URL=/models/inia-mentora.glb

# Domínios externos que viram LINK CLICÁVEL nos textos da INIA (análises, resultados de Workflow, respostas do chat), separados por
# vírgula: `intranet.empresa.com` ou `*.empresa.com`. Vazio (padrão) = nenhum: link externo aparece como texto com o domínio à vista
# (um texto induzido por uma transcrição ou documento não vira isca de phishing). Caminhos da própria INIA continuam links.
NEXT_PUBLIC_INIA_TRUSTED_LINK_HOSTS=
