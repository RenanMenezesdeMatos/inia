# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (monorepo: backend/, frontend/, etc. — not anchored to root)
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production / build output
build/
dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …exceto os modelos documentados (sem segredo), necessários para instalar a partir do repositório.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# INIA Mentora — arquivos intermediários do pipeline do avatar (Blender)
assets/avatar/inia/mentora/work/
__pycache__/

# Saídas locais (vídeos, capturas, áudios e relatórios gerados) — nunca versionadas.
/output/

# Saída do teste de carga (logs, PIDs, resultados)
tools/loadtest/out/
