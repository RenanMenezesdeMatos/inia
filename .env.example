# =====================================================================================================================
# INIA — Docker Compose (raiz do repositório). Copie para .env na raiz — ou rode `npm run env:init`, que gera uma
# senha aleatória e já aponta o backend/.env para este banco.
# =====================================================================================================================

# BANCO INTERNO DA INIA no Docker (serviço `postgres`). O backend usa estes valores em DATABASE_URL.
INIA_POSTGRES_USER=inia
INIA_POSTGRES_PASSWORD=troque-esta-senha
INIA_POSTGRES_DB=inia
# Porta publicada em 127.0.0.1. Troque se já existir um PostgreSQL na máquina usando a 5432.
INIA_POSTGRES_PORT=5432

# Senhas dos bancos EXTERNOS de exemplo (opcionais, só locais, dados fictícios) — `npm run env:init` gera valores
# aleatórios. ADMIN = superusuário dos contêineres de exemplo; READER = usuário somente leitura `inia_leitura`, o que a
# INIA usa em Central de Dados › Conectar banco de dados.
INIA_EXAMPLES_ADMIN_PASSWORD=
INIA_EXAMPLES_READER_PASSWORD=

# Portas dos bancos EXTERNOS de exemplo (perfil external-examples — opcional, só para experimentar a Central de Dados).
INIA_EXAMPLE_POSTGRES_PORT=55432
INIA_EXAMPLE_MARIADB_PORT=53306
INIA_EXAMPLE_MYSQL_PORT=53307
INIA_EXAMPLE_SQLSERVER_PORT=51433
