<?xml version="1.0" encoding="UTF-8"?>
<!--
  INIA — site do IIS que atende o ENDEREÇO PÚBLICO e encaminha para a INIA rodando na própria máquina.

  As pessoas acessam um endereço só (ex.: https://inia.empresa.local). O IIS manda:
    /api/...  e  /health  →  API da INIA        http://127.0.0.1:3333
    todo o resto          →  interface da INIA  http://127.0.0.1:3000

  Requisitos no servidor: IIS + módulos URL Rewrite 2.1 e Application Request Routing 3.0 (gratuitos, da Microsoft),
  com o proxy do ARR ligado no nível do servidor — o script configurar-iis.ps1 faz isso e copia este arquivo para a
  pasta do site trocando as portas, se forem outras.
  Guia completo: docs/manuais/IT-INIA-003 (Instalação em dois servidores).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- {UNENCODED_URL} = caminho + parâmetros exatamente como o navegador mandou (sem decodificar duas vezes). -->
        <rule name="INIA - API" stopProcessing="true">
          <match url="^(api/|health$)" />
          <action type="Rewrite" url="http://127.0.0.1:3333{UNENCODED_URL}" appendQueryString="false" />
        </rule>
        <rule name="INIA - interface" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="http://127.0.0.1:3000{UNENCODED_URL}" appendQueryString="false" />
        </rule>
      </rules>
    </rewrite>

    <!-- As respostas do chat da INIA chegam em fluxo: a compressão dinâmica do IIS seguraria tudo até o fim.
         A interface já comprime as próprias páginas. -->
    <urlCompression doStaticCompression="false" doDynamicCompression="false" />

    <security>
      <requestFiltering allowDoubleEscaping="true">
        <!-- Uploads (planilhas da Central de Dados, documentos da base, imagens de cenário): até 100 MB. -->
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>

    <!-- Erros do proxy aparecem como vieram da INIA (ex.: 401/403/422 com a mensagem da API), sem a página do IIS. -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
