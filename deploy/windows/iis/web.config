<?xml version="1.0" encoding="UTF-8"?>
<!--
  INIA — site do IIS que atende o ENDEREÇO PÚBLICO e encaminha para a INIA rodando na própria máquina.

  As pessoas acessam um endereço só (ex.: https://inia.empresa.local). O IIS manda:
    /api/...  e  /health  →  web farm "INIA-API"        (N processos da API:       127.0.0.1:3333, 127.0.0.2:3333, …)
    /internal/...         →  404 (métricas internas da API nunca são publicadas)
    todo o resto          →  web farm "INIA-Interface"  (N processos da interface: 127.0.0.1:3000, 127.0.0.2:3000, …)

  As web farms (servidores, health check em /ready da API e /healthz da interface, balanceamento por MENOS REQUISIÇÕES em
  andamento — o chat fica aberto em fluxo) são criadas pelo configurar-iis.ps1 no nível do servidor (applicationHost.config):
  elas não cabem neste arquivo. Uma instância só (o formato antigo) é uma web farm com um servidor.

  Requisitos no servidor: IIS + módulos URL Rewrite 2.1 e Application Request Routing 3.0 (gratuitos, da Microsoft),
  com o proxy do ARR ligado no nível do servidor — o script configurar-iis.ps1 faz tudo isso e copia este arquivo para a
  pasta do site.
  Guia completo: docs/manuais/IT-INIA-003 (Instalação em dois servidores) e docs/instalacao/dois-servidores-windows.md.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Métricas internas: só da própria máquina, direto na porta da API — nunca pelo endereço público. -->
        <rule name="INIA - interno" stopProcessing="true">
          <match url="^internal(/|$)" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Recurso não encontrado." />
        </rule>
        <!-- {UNENCODED_URL} = caminho + parâmetros exatamente como o navegador mandou (sem decodificar duas vezes). -->
        <rule name="INIA - API" stopProcessing="true">
          <match url="^(api/|health$)" />
          <action type="Rewrite" url="http://INIA-API{UNENCODED_URL}" appendQueryString="false" />
        </rule>
        <rule name="INIA - interface" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="http://INIA-Interface{UNENCODED_URL}" appendQueryString="false" />
        </rule>
      </rules>
    </rewrite>

    <!-- As respostas do chat da INIA chegam em fluxo: a compressão dinâmica do IIS seguraria tudo até o fim.
         A interface já comprime as próprias páginas. -->
    <urlCompression doStaticCompression="false" doDynamicCompression="false" />

    <security>
      <requestFiltering allowDoubleEscaping="true">
        <!-- Uploads (planilhas da Central de Dados, documentos da base, imagens de cenário): até 100 MB. -->
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>

    <!-- Erros do proxy aparecem como vieram da INIA (ex.: 401/403/422 com a mensagem da API), sem a página do IIS. -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
