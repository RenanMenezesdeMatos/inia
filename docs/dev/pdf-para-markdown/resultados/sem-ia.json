      {
        "doc": "duas-colunas-linha",
        "text": "Clientes em área sem cobertura de fibra são isentos da multa quando apresentam o protocolo de inviabilidade técnica",
        "before": false,
        "after": true
      },
      {
        "doc": "duas-colunas-linha",
        "text": "A portabilidade para outra operadora é concluída em até 3 dias úteis depois do pedido do cliente",
        "before": false,
        "after": true
      },
      {
        "doc": "duas-colunas-linha",
        "text": "O cancelamento por falecimento do titular é isento de multa em qualquer caso e exige a certidão de óbito",
        "before": false,
        "after": true
      },
      {
        "doc": "duas-colunas-coluna",
        "text": "A multa de cancelamento antecipado é proporcional aos meses que faltam para o fim da fidelização e nunca passa de R$ 300,00 por linha",
        "before": true,
        "after": true
      },
      {
        "doc": "duas-colunas-coluna",
        "text": "Pedidos de cancelamento feitos em até 7 dias depois da contratação pela internet ou por telefone seguem o direito de arrependimento",
        "before": true,
        "after": true
      },
      {
        "doc": "manual-chrome-tags",
        "text": "Na Regional Norte, a retirada do modem é feita pelos Correios: o cliente recebe um código de postagem válido por 30 dias corridos",
        "before": true,
        "after": true
      },
      {
        "doc": "manual-chrome-sem-tags",
        "text": "Na Regional Sudeste, clientes com mais de 60 meses de casa podem pedir a dispensa da multa diretamente ao supervisor",
        "before": true,
        "after": true
      },
      {
        "doc": "manual-tabelas",
        "text": "Quedas repetidas no mesmo dia, confirmadas pelo teste remoto da linha e pelo relato do cliente",
        "before": true,
        "after": true
      },
      {
        "doc": "manual-tabelas",
        "text": "Registrar as medições e enviar para Engenharia de Capacidade em até 2 dias úteis",
        "before": true,
        "after": true
      },
      {
        "doc": "manual-chrome-tags",
        "text": "Cliente com falha técnica comprovada em pelo menos três protocolos abertos nos últimos 60 dias corridos",
        "before": true,
        "after": true
      },
      {
        "doc": "manual-chrome-tags",
        "text": "A Ouvidoria decide em até 10 dias úteis e comunica o cliente por carta registrada",
        "before": true,
        "after": true
      },
      {
        "doc": "manual-chrome-sem-tags",
        "text": "Pedido anterior comprovado por protocolo, sem atendimento dentro do prazo informado ao cliente",
        "before": true,
        "after": true
      },
      {
        "doc": "it-008",
        "text": "Onde ficam as linhas recusadas, com o motivo (linha, campo, código). Nunca entram \"pela metade\".",
        "before": true,
        "after": true
      },
      {
        "doc": "it-008",
        "text": "A porta única por onde os dados do cliente entram na INIA. Nada entra \"por fora\".",
        "before": true,
        "after": true
      },
      {
        "doc": "it-013",
        "text": "Não executado de ponta a ponta. Só partes isoladas, fora do Windows, em 04/11/2026: o Node 24 e o build passam pelo proxy",
        "before": true,
        "after": true
      },
      {
        "doc": "simples",
        "text": "Durante o atendimento, confirme o endereço cadastrado",
        "before": false,
        "after": true
      }
    ]
