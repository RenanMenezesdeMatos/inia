# =====================================================================================================================
# INIA — backend (API). Copie para backend/.env — ou rode, na raiz, `npm run env:init`, que cria este arquivo com
# segredos aleatórios. NUNCA versione o .env com valores reais.
# =====================================================================================================================

# --- Ambiente ---------------------------------------------------------------------------------------------------------
# development = avaliação/uso local no próprio computador. production = qualquer servidor (com ou sem HTTPS): exige
# JWT_SECRET (≥ 32 caracteres) e DATA_HUB_SECRET_KEY próprios e recusa dados de demonstração.
NODE_ENV=development
# Atributo Secure do cookie de sessão: auto = só em production. Em servidor SEM HTTPS (rede interna) use false — o
# navegador descarta cookie Secure em HTTP. Com HTTPS deixe auto (ou true).
SESSION_COOKIE_SECURE=auto
# De quem aceitar X-Forwarded-For (IP do cliente nos limites de tentativas): loopback = IIS/proxy na mesma máquina
# (também com várias APIs atrás do mesmo IIS — web farm); lista de IPs/sub-redes do proxy se ele estiver em outra máquina
# (ex.: 10.0.0.5, 10.0.0.6 para dois IIS); false = nenhum (sem proxy na frente). Nunca "true".
TRUST_PROXY=loopback
# Tentativas de login por IP + e-mail a cada 5 minutos (além da trava de 5 falhas/15 min por e-mail). 0 desliga.
LOGIN_RATE_LIMIT_PER_IP_EMAIL=20
# Logins RECUSADOS por IP a cada 5 minutos (login certo não conta: a virada de turno atrás de Citrix/NAT passa). 0 desliga.
LOGIN_RATE_LIMIT_PER_IP=200
# Porta da API.
PORT=3333
# Endereço exato do frontend (CORS + conferência de origem das escritas com sessão — proteção contra CSRF). Mude se o
# frontend não estiver em http://localhost:3000. Mais de um: separe por vírgula. Nunca "*". Em production é obrigatória: a API
# não sobe sem ela (nem com localhost/http num endereço público).
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# --- BANCO INTERNO DA INIA (PostgreSQL 17) ----------------------------------------------------------------------------
# Onde a INIA guarda tudo o que é dela. NÃO é o banco do seu cliente: bancos EXTERNOS (SQL Server, PostgreSQL, MariaDB,
# MySQL dos clientes) são cadastrados depois pela tela Administração › Central de Dados, e a INIA só os LÊ.
# Com o Docker Compose da raiz (npm run db:up), use o usuário/senha do .env da raiz (npm run env:init preenche).
DATABASE_URL=postgresql://inia:troque-esta-senha@localhost:5432/inia
# Banco usado só pelos testes automatizados (npm test com provas de banco). Pode ficar como está se não for rodar testes.
TEST_DATABASE_URL=postgresql://inia:troque-esta-senha@localhost:5432/inia_test
# Conexões simultâneas do backend ao banco interno (por processo).
DATABASE_POOL_MAX=20
# Limites de cada conexão do SERVIDOR (migrations, seeds e scripts não os recebem). 0 = sem limite.
# Espera máxima por uma conexão livre do pool (pool esgotado vira erro, nunca espera infinita).
DATABASE_CONNECTION_TIMEOUT_MS=10000
# Duração máxima de um comando: processo `api` / processos `worker` e `all` (e cargas da Central de Dados).
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_WORKER_STATEMENT_TIMEOUT_MS=300000
# Transação aberta e parada além disso é encerrada pelo banco (solta os bloqueios de uma transação esquecida).
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000

# --- Processos ---------------------------------------------------------------------------------------------------------
# Desligamento (serviço parado/reiniciado): a API sai da prontidão (/ready = 503), espera INIA_SHUTDOWN_DRAIN_MS para o
# balanceador (web farm do IIS) tirá-la (padrão: 5000 em production, 0 fora) e tem INIA_SHUTDOWN_TIMEOUT_MS para terminar
# tudo (padrão 25000; precisa ficar abaixo do <stoptimeout> do serviço, 30 s no instalador do Windows).
# INIA_SHUTDOWN_DRAIN_MS=5000
# INIA_SHUTDOWN_TIMEOUT_MS=25000
# Métricas internas (event loop, pool do banco, latência por rota, limitador de IA): GET http://127.0.0.1:<porta da API>/internal/metrics
# e o /health do processamento — só da própria máquina, nunca pelo IIS. Com token (16+ caracteres), exigem também
# "Authorization: Bearer <token>".
# INIA_METRICS_TOKEN=
# Papel deste processo: all = API + processamento num processo só (padrão, como sempre); api = só a API (telas, chat,
# voz); worker = só o processamento (Workflows, feedbacks, tarefas periódicas). Separado, o lote de IA não divide o
# processador com as telas. Também dá para escolher na linha de comando: npm run start:api / npm run start:worker.
# INIA_PROCESS_ROLE=all
# Execuções de Workflow em paralelo por processo de processamento.
# WORKFLOW_WORKER_CONCURRENCY=8
# Quantas vezes o mesmo nó que chama a IA roda numa execução de Workflow (ciclos); passou disso, a execução é encerrada.
# WORKFLOW_MAX_PAID_NODE_RUNS=5
# /health do processo "worker" (só nesta máquina). 0 = não abre porta.
# WORKER_HEALTH_PORT=3334

# --- Segurança ---------------------------------------------------------------------------------------------------------
# Assinatura das sessões de login (HS256). Valor longo e aleatório, ≥ 32 caracteres (npm run env:init gera 96).
# Trocar derruba todas as sessões e zera a trava de tentativas de login (o identificador é um HMAC com esta chave).
JWT_SECRET=troque-por-um-valor-aleatorio-longo
JWT_EXPIRES_IN=12h
# Minutos sem uso (nenhuma interação com a tela, nenhuma fala na voz) até a sessão encerrar sozinha; a tela avisa 2 minutos
# antes. 0 desliga. Padrão 30.
SESSION_IDLE_TIMEOUT_MINUTES=30
# Validade (horas) da senha temporária do primeiro administrador e das contas liberadas pela tela de acessos.
TEMPORARY_PASSWORD_TTL_HOURS=72
# Chave (32 bytes em hex) que cifra as credenciais dos bancos externos e das APIs cadastradas na Central de Dados.
# Fica FORA do banco: sem ela, quem copiar só o banco não lê as senhas. Guarde com o mesmo cuidado de um backup;
# perder a chave obriga a redigitar as senhas das conexões. Obrigatória em produção (npm run env:init gera).
DATA_HUB_SECRET_KEY=
# Só durante a TROCA da chave acima: a chave antiga, para a INIA ainda ler o que foi cifrado com ela até rodar
# `npm run secrets:rotate -- --aplicar`. Depois da recifragem, apague. Passo a passo: docs/security/configuracao-segura.md §11.
DATA_HUB_SECRET_KEY_PREVIOUS=
# Dias que o conteúdo bruto de cada carga fica guardado (para reprocessar).
DATA_HUB_RAW_RETENTION_DAYS=30

# Consulta de dados da Central: valores iniciais conservadores, explicados em docs/dev/central-de-dados-consulta.md. Cada variável tem um teto em
# src/config/env.ts, que impede "sem limite".
# DATA_EXPLORER_DEFAULT_PAGE_SIZE=25
# DATA_EXPLORER_MAX_PAGE_SIZE=100
# DATA_EXPLORER_QUERY_TIMEOUT_MS=5000
# DATA_EXPLORER_COUNT_CAP=10000
# DATA_EXPLORER_EXPORT_MAX_ROWS=20000
# DATA_EXPLORER_EXPORT_MAX_BYTES=20971520
# DATA_EXPLORER_EXPORT_MAX_DURATION_MS=60000
# DATA_EXPLORER_QUERIES_PER_MINUTE=30
# DATA_EXPLORER_QUERIES_PER_MINUTE_ORGANIZATION=120
# DATA_EXPLORER_EXPORTS_PER_10_MINUTES=5
# DATA_EXPLORER_EXPORTS_PER_10_MINUTES_ORGANIZATION=15
# DATA_EXPLORER_CANCEL_MAX_ROWS=10000
# DATA_EXPLORER_CANCELLATIONS_PER_10_MINUTES=10
# DATA_EXPLORER_CANCELLATIONS_PER_10_MINUTES_ORGANIZATION=30

# --- Inteligência artificial ------------------------------------------------------------------------------------------
# Chave da API Gemini (Google AI Studio). Vazia = a INIA funciona, mas os recursos de IA (feedbacks, chat, voz) ficam
# indisponíveis. Provedores e modelos também podem ser configurados em Administração › IA / Modelos.
GEMINI_API_KEY=
# Máscara dos dados de CLIENTE (CPF, telefone, e-mail, protocolo) nas transcrições enviadas à IA. ON (padrão) = o modelo nunca
# recebe esses dados e a evidência é conferida contra o mesmo texto mascarado; o original fica no banco. OFF só com decisão do DPO.
INIA_MODEL_PII_MASKING=ON
# Limitador de chamadas de IA DE CADA PROCESSO (API ou processamento): no máximo INIA_AI_MAX_CONCURRENT_CALLS chamadas ao
# mesmo tempo neste processo, das quais INIA_AI_RESERVED_INTERACTIVE_CALLS ficam reservadas ao chat/voz/telas — o lote dos
# Workflows nunca as usa. Fila e prioridade são de cada processo; é uma proteção local (memória, event loop).
# O LIMITE DO PROVEDOR é da CONEXÃO, não daqui: Administração › IA › Provedores › conexão › "Chamadas simultâneas" (o limite
# por acesso que o provedor informar), dividido por TODAS as instâncias. Um 429 de uma conexão pausa os lotes daquela conexão
# em todas as instâncias (o chat nunca é pausado). Limite de requisições (429): o lote espera e tenta de novo; o chat tenta
# uma vez a mais e avisa. OFF = sem limitador.
# INIA_AI_LIMITER=ON
# INIA_AI_MAX_CONCURRENT_CALLS=16
# INIA_AI_RESERVED_INTERACTIVE_CALLS=4

# --- Dados de demonstração (opcional) ----------------------------------------------------------------------------------
# Senha única das contas da massa de demonstração (npm run setup -- --demo / npm run db:seed:demo). 8+ caracteres;
# npm run env:init gera uma aleatória. Só para instalações de demonstração — nunca use uma delas com dados reais.
INIA_DEMO_PASSWORD=

# --- Recursos opcionais (padrão desligado) -----------------------------------------------------------------------------
# Revisão de qualidade dos feedbacks de atendimento (QA) e política de entrega.
INIA_INTERACTION_FEEDBACK_PIPELINE=OFF
INIA_FEEDBACK_DELIVERY_POLICY=PILOT_V1
# Monitoria de usabilidade (coleta de uso e painel). Independentes.
INIA_USAGE_COLLECTION=OFF
INIA_USABILITY_PANEL=OFF
# Base de boas práticas — SÓ DESENVOLVIMENTO: chave de um dataset sintético (ex.: BP_SINTETICO_V1) cujos padrões aprovados o chat do
# operador usa no lugar dos reais (sempre rotulados como sintéticos). Vazio = só padrões reais. Ignorado em produção.
# INIA_BEST_PRACTICES_CHAT_SYNTHETIC_DATASET=
# Rótulo do ambiente gravado nos eventos de uso (vazio = NODE_ENV).
# INIA_ENVIRONMENT=homologacao

# Conferência das respostas contra assuntos proibidos e limites (PEN-017). Sem valor, vale ENFORCE.
# ENFORCE: confere antes de entregar (prevenção); a fala gerada pelo modelo de voz continua só com detecção posterior.
# AUDIT: entrega e confere depois (só detecção, não é prevenção). OFF: não confere nem registra (nem prevenção, nem detecção).
# INIA_RESPONSE_CHECK=ENFORCE
