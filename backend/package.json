{
  "name": "@inia/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main/server.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:create": "tsx src/infrastructure/database/create-databases.ts",
    "db:migrate": "tsx src/infrastructure/database/migrate.ts",
    "db:migrate:test": "NODE_ENV=test tsx src/infrastructure/database/migrate.ts",
    "db:bootstrap": "tsx src/infrastructure/database/bootstrap.ts",
    "db:bootstrap:test": "NODE_ENV=test tsx src/infrastructure/database/bootstrap.ts",
    "db:bootstrap:check": "tsx src/infrastructure/database/seed-demo-check.ts",
    "db:seed:reference": "tsx src/infrastructure/database/seed-reference.ts",
    "db:seed:reference:test": "NODE_ENV=test tsx src/infrastructure/database/seed-reference.ts",
    "db:seed:demo": "tsx src/infrastructure/database/seed-demo.ts",
    "db:seed:demo:test": "NODE_ENV=test tsx src/infrastructure/database/seed-demo.ts",
    "db:seed:demo:check": "tsx src/infrastructure/database/seed-demo-check.ts",
    "db:seed:demo:reset": "tsx src/infrastructure/database/reset-demo.ts",
    "db:seed:demo:reset:test": "NODE_ENV=test tsx src/infrastructure/database/reset-demo.ts",
    "calendar:reconcile": "tsx src/infrastructure/database/reconcile-calendar.ts",
    "analytics:rollup": "tsx src/infrastructure/database/rebuild-analytics-read-model.ts",
    "db:migrate-legacy-workflow-outputs": "tsx src/infrastructure/database/migrate-legacy-workflow-outputs.ts",
    "setup": "tsx src/infrastructure/installation/setup.ts",
    "update": "tsx src/infrastructure/installation/update.ts",
    "admin:create": "tsx src/infrastructure/installation/create-admin.ts",
    "secrets:rotate": "tsx scripts/seguranca/recifrar-segredos.ts",
    "errors:catalog": "tsx scripts/errors/error-catalog.ts",
    "config:exportar": "tsx scripts/config-transfer/exportar.ts",
    "config:importar": "tsx scripts/config-transfer/importar.ts",
    "dev:api": "tsx watch src/main/server.ts --role=api",
    "dev:worker": "tsx watch src/main/server.ts --role=worker",
    "start:api": "node dist/main/server.js --role=api",
    "start:worker": "node dist/main/server.js --role=worker"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.2",
    "mssql": "^12.7.4",
    "multer": "^2.5.0",
    "mysql2": "^3.24.5",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "pino": "^9.9.4",
    "ssh2": "^1.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mssql": "^12.3.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.3.1",
    "@types/pg": "^8.15.5",
    "@types/ssh2": "^1.15.6",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.35.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    },
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
